# ============================================
# SkyEngine 环境变量配置示例
# 复制为 .env 后填写实际值: cp .env.example .env
# ============================================

# ---------- SkyEngine 在线仿真服务 ----------
# 宿主机端口；start.sh 检测到占用时会自动改为下一个可用端口
BACKEND_PORT=8233
FRONTEND_PORT=5180
ENGINE_PORT=8080
BATCH_ENGINE_PORT=8081

# SkyEngine docker-compose-online.yaml 的绝对路径 (容器内挂载用)
SKYENGINE_COMPOSE_PATH=/path/to/skyengine/docker-compose-online.yaml

# SkyEngine docker-compose.yaml 的绝对路径 (批处理/实验 compose)
SKYENGINE_BATCH_COMPOSE_PATH=/path/to/skyengine/docker-compose.yaml

# SkyEngine 项目在宿主机上的根目录（只作为 bind mount 源）
SKYENGINE_PROJECT_HOST_DIR=/path/to/skyengine

# 后端容器内的 Docker Compose 传给 Docker 守护进程的宿主机路径
# Linux 与 SKYENGINE_PROJECT_HOST_DIR 相同，install.sh 自动填写
# Windows 示例: /run/desktop/mnt/host/e/work/tiangong/skyengine
SKYENGINE_DOCKER_HOST_DIR=/path/to/skyengine

# SkyEngine dataset 目录宿主机路径 (批处理实例上传用)
SKYENGINE_BATCH_DATASET_HOST_DIR=/path/to/skyengine/dataset

# ---------- RAG 助手 (vLLM) ----------
# SkyEngine application backend 地址 (Docker Compose 前端容器内使用服务名)
# 本地 npm run dev 默认使用 http://localhost:8000，通常不需要从根目录 .env 读取
BACKEND_URL=http://backend:8000

# RAG 后端服务地址
RAG_BACKEND_URL=http://127.0.0.1:8000

# RAG 模型名称
RAG_MODEL_NAME=qwen3.6-35b

# RAG API Key (本地推理服务可留空)
RAG_API_KEY=

# ---------- GPU ----------
# auto: 自动探测可由 Docker + PyTorch 使用的 NVIDIA GPU；cuda: 必须使用 GPU；cpu: 强制使用 CPU
SKYENGINE_GPU_MODE=auto

# install.sh 写入最近一次探测到的设备数量，仅用于展示和诊断
SKYENGINE_GPU_COUNT=0
